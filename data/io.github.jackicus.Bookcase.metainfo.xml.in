<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>

  <name>Bookcase@NAME_SUFFIX@</name>
  <summary>Keep your e-books in order and read them</summary>
  <description>
    <p>
      Bookcase keeps your e-books in one place and lets you read them. Add the books you
      have, and it shows them as a shelf of covers, sorted into authors, series and genres,
      with the book you are reading always one click away.
    </p>
    <p>
      Your files stay where you keep them: Bookcase reads a folder or a Calibre library in
      place and never renames, moves or rewrites a book. Edits to titles, series and covers
      live in its own library, and go with a copy when you send a book to your e-reader.
    </p>
    <ul>
      <li>EPUB, Kobo EPUB, MOBI, AZW3, FB2, CBZ comics, PDF and plain text</li>
      <li>A reader with pages side by side, your choice of type and paper, highlights,
        notes and bookmarks</li>
      <li>Series in order, shelves of your own, and smart shelves that fill themselves</li>
      <li>Fix titles, authors and covers by hand or from Open Library</li>
      <li>Send books to a Kobo, Kindle or other e-reader over USB</li>
      <li>Open a Calibre library as it is, without changing it</li>
      <li>Undo anything, from an edit to a removed shelf</li>
    </ul>
  </description>

  <developer id="io.github.jackicus">
    <name translate="no">Jack Tully</name>
  </developer>

  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <url type="homepage">https://github.com/Jackicus/GNOME-Bookcase</url>
  <url type="bugtracker">https://github.com/Jackicus/GNOME-Bookcase/issues</url>
  <url type="help">https://github.com/Jackicus/GNOME-Bookcase/blob/main/docs/user-guide.md</url>
  <url type="vcs-browser">https://github.com/Jackicus/GNOME-Bookcase</url>

  <translation type="gettext">bookcase</translation>

  <provides>
    <binary>bookcase</binary>
    <mediatype>application/epub+zip</mediatype>
    <mediatype>application/x-mobipocket-ebook</mediatype>
    <mediatype>application/vnd.amazon.mobi8-ebook</mediatype>
    <mediatype>application/x-fictionbook+xml</mediatype>
    <mediatype>application/x-zip-compressed-fb2</mediatype>
    <mediatype>application/vnd.comicbook+zip</mediatype>
    <mediatype>application/x-cbz</mediatype>
  </provides>

  <content_rating type="oars-1.1"/>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>

  <branding>
    <color type="primary" scheme_preference="light">#e9d3bb</color>
    <color type="primary" scheme_preference="dark">#63452c</color>
  </branding>

  <screenshots>
    <screenshot type="default" environment="gnome">
      <caption>Home: the books you are reading, and what was added lately</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Bookcase/v0.2.0/data/screenshots/home-light.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>Reading a novel, two pages side by side</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Bookcase/v0.2.0/data/screenshots/reader-light.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>A book's details: its series, progress and highlights</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Bookcase/v0.2.0/data/screenshots/book-light.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>The whole library as covers, in the dark style</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Bookcase/v0.2.0/data/screenshots/library-dark.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>Reading at night</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Bookcase/v0.2.0/data/screenshots/reader-dark.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>A Kobo plugged in: what is on it, and what to send</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Bookcase/v0.2.0/data/screenshots/device-light.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>Reading goals and statistics: the year's goal, the books finished, the streak</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Bookcase/v0.2.0/data/screenshots/stats-light.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>Discover: free books from online catalogues, and from your own server</caption>
      <image type="source" width="1100" height="760">https://raw.githubusercontent.com/Jackicus/GNOME-Bookcase/v0.2.0/data/screenshots/discover-light.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.2.0" date="2026-10-08">
      <description>
        <p>Bookcase reads everything it keeps, and finds more.</p>
        <ul>
          <li>PDFs open in the reader, with zoom, spreads, contents, search and highlights; so do text files and CBR comics</li>
          <li>Statistics: a yearly reading goal, streaks and a year of reading at a glance</li>
          <li>Look up a word or a name without leaving the book, and have it read aloud</li>
          <li>Discover free books in online catalogues, or your own Calibre-Web, Kavita or Komga</li>
          <li>Reading positions synced with KOReader devices</li>
          <li>Send to Kindle by e-mail, Kindle highlights in, highlights out as Markdown</li>
          <li>Find details for many books at once, find and merge duplicates</li>
          <li>A welcome that finds your Calibre library and folders of books, and books read without adding them</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-08">
      <description>
        <p>The first release.</p>
        <ul>
          <li>A library of covers with authors, series, tags, shelves and smart shelves</li>
          <li>A reader for EPUB, MOBI, AZW3, FB2 and comics, with highlights and notes</li>
          <li>Metadata and covers by hand or from Open Library</li>
          <li>Calibre libraries and watched folders read in place</li>
          <li>Sending to Kobo, Kindle and other e-readers over USB</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
