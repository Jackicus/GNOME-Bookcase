using Gtk 4.0;
using Adw 1;

// A grid (or list) of books: All Books, a reading state, a shelf, an author's, a series', a
// tag's or a search's books (pages/books.py).
template $BookcaseBooksPage: Adw.NavigationPage {
  title: _("All Books");

  child: Adw.BreakpointBin breakpoint_bin {
    width-request: 360;
    height-request: 240;

    Adw.Breakpoint compact_breakpoint {
      condition ("max-width: 520sp")
    }

    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle window_title {
          title: _("All Books");
        };

        [end]
        MenuButton sort_button {
          icon-name: "view-sort-descending-symbolic";
          tooltip-text: _("Sort and View");
          menu-model: view_menu;
        }

        [end]
        ToggleButton filter_button {
          icon-name: "funnel-symbolic";
          tooltip-text: _("Filter");
          active: bind filter_revealer.reveal-child bidirectional;
        }

        [end]
        ToggleButton search_button {
          icon-name: "system-search-symbolic";
          tooltip-text: _("Search");
          active: bind search_bar.search-mode-enabled bidirectional;
        }
      }

      [top]
      SearchBar search_bar {
        key-capture-widget: breakpoint_bin;

        child: Adw.Clamp {
          maximum-size: 520;

          child: SearchEntry search_entry {
            placeholder-text: _("Search title, author, series, tags…");
            hexpand: true;
            search-delay: 200;
          };
        };
      }

      // The filter bar: a chip per filter, each a menu of choices (pages/books.py fills
      // them), turned into a search added to what is typed.
      [top]
      Revealer filter_revealer {
        transition-type: slide_down;

        // A wrap box: in a narrow window the chips take a second line, none hidden.
        child: Adw.WrapBox filter_box {
            child-spacing: 6;
            line-spacing: 6;
            align: 0.5;
            margin-start: 12;
            margin-end: 12;
            margin-top: 6;
            margin-bottom: 6;
            halign: center;

            styles [
              "filter-bar",
            ]

            MenuButton format_chip {
              label: _("Format");
              always-show-arrow: true;
              tooltip-text: _("Filter by Format");

              styles [
                "filter-chip",
              ]
            }

            MenuButton status_chip {
              label: _("Status");
              always-show-arrow: true;
              tooltip-text: _("Filter by Reading Status");

              styles [
                "filter-chip",
              ]
            }

            MenuButton rating_chip {
              label: _("Rating");
              always-show-arrow: true;
              tooltip-text: _("Filter by Rating");

              styles [
                "filter-chip",
              ]
            }

            MenuButton language_chip {
              label: _("Language");
              always-show-arrow: true;
              tooltip-text: _("Filter by Language");

              styles [
                "filter-chip",
              ]
            }

            Button clear_filters_button {
              label: _("_Clear");
              use-underline: true;
              visible: false;
              tooltip-text: _("Clear the Filters");

              styles [
                "flat",
              ]
            }
        };
      }

      content: Stack stack {
        transition-type: crossfade;

        StackPage {
          name: "grid";

          child: ScrolledWindow grid_scroller {
            hscrollbar-policy: never;

            child: GridView grid_view {
              max-columns: 30;
              min-columns: 2;
              enable-rubberband: true;

              styles [
                "book-grid",
              ]
            };
          };
        }

        StackPage {
          name: "list";

          child: ScrolledWindow {
            child: ColumnView column_view {
              show-column-separators: false;
              show-row-separators: true;
              reorderable: false;
              enable-rubberband: true;

              styles [
                "book-list",
              ]

              ColumnViewColumn title_column {
                title: _("Title");
                expand: true;
                resizable: true;
              }

              ColumnViewColumn author_column {
                title: _("Author");
                expand: true;
                resizable: true;
              }

              ColumnViewColumn series_column {
                title: _("Series");
                expand: true;
                resizable: true;
              }

              ColumnViewColumn added_column {
                title: _("Added");
                fixed-width: 104;
                resizable: true;
              }

              ColumnViewColumn rating_column {
                title: _("Rating");
                fixed-width: 92;
              }

              ColumnViewColumn format_column {
                title: _("Format");
                fixed-width: 76;
                resizable: true;
              }

              ColumnViewColumn progress_column {
                title: _("Progress");
                fixed-width: 84;
              }
            };
          };
        }

        StackPage {
          name: "empty";

          child: Adw.StatusPage empty_page {
            icon-name: "library-symbolic";
            title: _("No Books Yet");

            child: Button empty_button {
              label: _("_Add Books…");
              use-underline: true;
              halign: center;
              action-name: "app.add-books";

              styles [
                "pill",
                "suggested-action",
              ]
            };
          };
        }
      };
    };
  };
}

menu view_menu {
  section {
    label: _("Sort By");

    item {
      label: _("_Date Added");
      action: "books.sort-order";
      target: "added";
    }

    item {
      label: _("_Title");
      action: "books.sort-order";
      target: "title";
    }

    item {
      label: _("_Author");
      action: "books.sort-order";
      target: "author";
    }

    item {
      label: _("_Series");
      action: "books.sort-order";
      target: "series";
    }

    item {
      label: _("_Published");
      action: "books.sort-order";
      target: "published";
    }

    item {
      label: _("_Last Read");
      action: "books.sort-order";
      target: "last-read";
    }

    item {
      label: _("_Rating");
      action: "books.sort-order";
      target: "rating";
    }
  }

  section {
    item {
      label: _("Re_verse Order");
      action: "books.sort-reversed";
    }
  }

  section {
    label: _("Show As");

    item {
      label: _("_Covers");
      action: "books.view-mode";
      target: "grid";
    }

    item {
      label: _("L_ist");
      action: "books.view-mode";
      target: "list";
    }
  }

  section {
    label: _("Cover Size");

    item {
      custom: "cover-size";
    }
  }
}
