using Gtk 4.0;
using Adw 1;

// A connected e-reader (pages/device.py): its storage, Eject, and the books on it, in two
// lists: those not in the library (each with Add) and those that are (each opens the book).
// Select turns on check boxes and a bottom bar to remove books from the device. A Kobo adds
// its collections switch and reading progress; any device a shelf's unsent books.
template $BookcaseDevicePage: Adw.NavigationPage {
  title: _("Device");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      Button eject_button {
        icon-name: "media-eject-symbolic";
        tooltip-text: _("Eject");
      }

      [end]
      ToggleButton select_button {
        icon-name: "selection-mode-symbolic";
        tooltip-text: _("Select");
        sensitive: false;
      }
    }

    content: Stack stack {
      transition-type: crossfade;

      StackPage {
        name: "loading";

        child: Adw.Spinner {
          halign: center;
          valign: center;
          width-request: 32;
          height-request: 32;
        };
      }

      StackPage {
        name: "gone";

        child: Adw.StatusPage gone_status {
          icon-name: "tablet-symbolic";
          title: _("Device Disconnected");
        };
      }

      StackPage {
        name: "books";

        child: ScrolledWindow {
          hscrollbar-policy: never;

          child: Adw.Clamp {
            maximum-size: 720;
            tightening-threshold: 560;

            child: Box {
              orientation: vertical;
              spacing: 24;
              margin-top: 24;
              margin-bottom: 24;
              margin-start: 12;
              margin-end: 12;

              // The device and its storage.
              Box {
                orientation: vertical;
                spacing: 12;

                styles [
                  "card",
                  "device-storage",
                ]

                Box {
                  spacing: 12;

                  Image kind_image {
                    icon-name: "ebook-reader";
                    pixel-size: 48;
                    accessible-role: presentation;
                  }

                  Box {
                    orientation: vertical;
                    valign: center;
                    hexpand: true;

                    Label name_label {
                      xalign: 0;
                      ellipsize: end;

                      styles [
                        "heading",
                      ]
                    }

                    Label summary_label {
                      xalign: 0;
                      ellipsize: end;

                      styles [
                        "caption",
                        "dimmed",
                      ]
                    }
                  }
                }

                LevelBar space_bar {
                  min-value: 0;
                  max-value: 1;
                  mode: continuous;
                }

                Label space_label {
                  xalign: 0;
                  wrap: true;

                  styles [
                    "caption",
                    "numeric",
                  ]
                }
              }

              Adw.StatusPage empty_status {
                visible: false;
                title: _("No Books on This Device");
                description: _("Send books to it with Send to Device… in a book’s menu");

                styles [
                  "compact",
                ]
              }

              // A Kindle's highlights (documents/My Clippings.txt), to import.
              Adw.PreferencesGroup clippings_group {
                visible: false;

                Adw.ActionRow clippings_row {
                  title: _("Import _Highlights…");
                  subtitle: _("From this Kindle’s My Clippings.txt");
                  use-underline: true;
                  activatable: true;

                  [suffix]
                  Image {
                    icon-name: "go-next-symbolic";
                    accessible-role: presentation;
                  }
                }
              }

              // A Kobo's own database: shelves as its collections (opted into per Kobo),
              // and its reading progress brought into the library.
              Adw.PreferencesGroup kobo_group {
                visible: false;
                title: _("Kobo");

                Adw.SwitchRow collections_row {
                  title: _("Sync Shelves as Kobo Collections");
                  subtitle: _("Writes the Kobo’s database, with a backup beside it");
                  subtitle-lines: 4;
                }

                Adw.ActionRow progress_row {
                  visible: false;
                  title: _("Bring Reading Progress From Kobo");
                  subtitle-lines: 2;

                  [suffix]
                  Button progress_button {
                    label: _("_Bring");
                    use-underline: true;
                    valign: center;
                  }
                }
              }

              // The books of a shelf that are not on the device yet, to send.
              Adw.PreferencesGroup send_group {
                visible: false;

                Adw.ActionRow shelf_row {
                  title: _("Send Unsent Books on a Shelf");
                  subtitle-lines: 2;

                  [suffix]
                  MenuButton shelf_button {
                    label: _("_Shelf");
                    use-underline: true;
                    always-show-arrow: true;
                    valign: center;
                    tooltip-text: _("Choose a Shelf");
                  }
                }
              }

              Adw.PreferencesGroup outside_group {
                title: _("Not in Your Library");
                description: _("Add a copy to keep it in Bookcase");

                header-suffix: Button add_all_button {
                  label: _("_Add All");
                  use-underline: true;
                  valign: center;

                  styles [
                    "flat",
                  ]
                };

                ListBox outside_list {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]
                }
              }

              Adw.PreferencesGroup inside_group {
                title: _("In Your Library");

                ListBox inside_list {
                  selection-mode: none;

                  styles [
                    "boxed-list",
                  ]
                }
              }
            };
          };
        };
      }
    };

    [bottom]
    ActionBar selection_bar {
      revealed: false;

      [start]
      Label selection_label {
        ellipsize: end;
      }

      [end]
      Button remove_button {
        label: _("_Remove…");
        use-underline: true;
        sensitive: false;

        styles [
          "destructive-action",
        ]
      }
    }
  };
}
